# Supabase Database URL
DATABASE_URL=postgresql://username:password@db.supabase.co:5432/postgres

# JWT Secret (genera uno aleatorio)
JWT_SECRET=tu_jwt_secret_muy_seguro_aqui

# Puerto del servidor
PORT=3000

# ============================================
# EMAIL CONFIGURATION (para notificaciones)
# ============================================
# Opciones: 'gmail', 'sendgrid', 'resend', 'smtp'
EMAIL_SERVICE=gmail

# Para Gmail (usar App Password, no contraseña normal)
EMAIL_USER=tu-email@gmail.com
EMAIL_PASSWORD=tu-app-password-aqui

# Para SendGrid
# EMAIL_SENDGRID_API_KEY=tu-api-key-aqui

# Para Resend
# EMAIL_RESEND_API_KEY=tu-api-key-aqui

# Configuración del remitente
EMAIL_FROM_ADDRESS=noreply@ameco.cl
EMAIL_FROM_NAME=Sistema AMECO

# URL base del sistema (para links en emails)
BASE_URL=http://localhost:3000